# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override (defaults try gemini-3.6-flash, then flash-latest / 3.5)
# GEMINI_MODEL=gemini-3.6-flash

# —— Wallet / purchase (MetaMask · Base Sepolia) ——
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
# Real 0x treasury or lot contract — if unset, Pay uses demo self-settlement
# NEXT_PUBLIC_CELLS_TREASURY=0xYourTreasuryAddressHere
# NEXT_PUBLIC_LOT_CONTRACT=0xYourLotContractHere
