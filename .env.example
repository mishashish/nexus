# —— Gemini (server) ——
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (defaults: gemini-3.6-flash → flash-latest → 3.5)
# GEMINI_MODEL=gemini-3.6-flash

# —— Seats DB (Vercel KV / Upstash Redis) ——
# Required on Vercel for durable ownership across instances.
# Local/dev falls back to .data/seats.json if unset.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# —— Wallet / purchase (MetaMask) ——
# Treasury REQUIRED for purchases.
NEXT_PUBLIC_CELLS_TREASURY=0xYourTreasuryAddressHere
# Future NFT lot contract (optional hook)
# NEXT_PUBLIC_LOT_CONTRACT=0xYourLotContractHere

# —— Project coin (ERC-20) ——
# When unset → seats paid in native ETH.
# When set → MetaMask transfers this token to treasury (ready for launch).
# NEXT_PUBLIC_PAY_TOKEN=0xYourTokenContractHere
# NEXT_PUBLIC_PAY_TOKEN_SYMBOL=CELLS
# NEXT_PUBLIC_PAY_TOKEN_DECIMALS=18
#
# Default seat prices (human units of the token):
#   #001  → 1000   (~entry / ~0.015 ETH band)
#   #095  → 2500   (~mid / ~0.025 ETH band)
#   #064  → 5000   (~premium / ~0.035 ETH band)
# Adjust in src/lib/contracts.ts FEATURED + priceTokenForIndex after listing.

# —— Network presets ——
# Staging (Base Sepolia):
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org

# Production (Base mainnet) — swap these on Vercel Production env:
# NEXT_PUBLIC_CHAIN_ID=8453
# NEXT_PUBLIC_CHAIN_NAME=Base
# NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
# NEXT_PUBLIC_EXPLORER_URL=https://basescan.org
